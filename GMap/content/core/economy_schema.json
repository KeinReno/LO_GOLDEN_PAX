  "flow_key_format": "<category>.T<tier>",
  "rps_edges": [
    {
      "edge": "A->B",
      "from": "A",
      "to": "B",
      "input1": "Extracta Tn",
      "input2": "Energia Tn-1",
      "output": "Materia Tn",
      "description": "Руда + энергия = сплав"
    },
    {
      "edge": "B->C",
      "from": "B",
      "to": "C",
      "input1": "Materia Tn",
      "input2": "Bios Tn-2",
      "output": "Industria Tn",
      "description": "Сплав + рабочие = мощность"
    },
    {
      "edge": "C->D",
      "from": "C",
      "to": "D",
      "input1": "Industria Tn",
      "input2": "Materia Tn-1",
      "output": "Energia Tn",
      "description": "Завод + детали = генератор/орудие"
    },
    {
      "edge": "D->E",
      "from": "D",
      "to": "E",
      "input1": "Energia Tn",
      "input2": "Extracta Tn-2",
      "output": "Bios Tn",
      "description": "Энергия + вода = гидропоника/медицина"
    },
    {
      "edge": "E->F",
      "from": "E",
      "to": "F",
      "input1": "Bios Tn",
      "input2": "Industria Tn-2",
      "output": "Cognitio Tn",
      "description": "Население + лаб.оборудование = наука"
    },
    {
      "edge": "F->A",
      "from": "F",
      "to": "A",
      "input1": "Cognitio Tn",
      "input2": "Energia Tn-2",
      "output": "Extracta Tn+1",
      "description": "Технология + энергия = доступ к следующему tier добычи"
    }
  ],
