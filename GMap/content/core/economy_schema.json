{
  "meta": {
    "version": 1,
    "description": "Экономическая модель GMap: 6 категорий × 10 уровней × RPS-цикл. Аддитивная надстройка над legacy-валютами currency.metal/currency.supply."
  },
  "categories": {
    "A": { "id": "A", "name": "Сырьё", "role": "Добыча сырья из недр", "currencyId": "currency.extracta", "color": "#8d6e3a" },
    "B": { "id": "B", "name": "Материалы", "role": "Переработанные материалы и сплавы", "currencyId": "currency.materia", "color": "#7a8fa6" },
    "C": { "id": "C", "name": "Промышленность", "role": "Производственная мощность", "currencyId": "currency.industria", "color": "#c98a3a" },
    "D": { "id": "D", "name": "Энергия", "role": "Энергия, топливо, орудийные компоненты", "currencyId": "currency.energia", "color": "#e8c44c" },
    "E": { "id": "E", "name": "Биомасса", "role": "Еда, биомасса, население, мораль", "currencyId": "currency.bios", "color": "#5cdb95" },
    "F": { "id": "F", "name": "Знание", "role": "Наука, реликты, псионика, аномалии", "currencyId": "currency.cognitio", "color": "#9b6bff" }
  },
  "tiers": {
    "1":  { "id": 1,  "label": "T1 — Массовое сырьё",       "description": "Добывается на любой планете; малый, но стабильный поток" },
    "2":  { "id": 2,  "label": "T2 — Обработанное базовое",  "description": "Ранние переработка и химия" },
    "3":  { "id": 3,  "label": "T3 — Стратегические ранние", "description": "Узкое место средней игры" },
    "4":  { "id": 4,  "label": "T4 — Продвинутые материалы", "description": "Требуют спец. зданий и технологий" },
    "5":  { "id": 5,  "label": "T5 — Ценные",                "description": "Валюта, проводники, катализаторы" },
    "6":  { "id": 6,  "label": "T6 — Редкие стратегические", "description": "Ключ к кораблям и корпусам верхнего класса" },
    "7":  { "id": 7,  "label": "T7 — Экзотика",              "description": "Локализованы на конкретных планетах; уникальные комбинации" },
    "8":  { "id": 8,  "label": "T8 — Псионика/аномальные",   "description": "Базис псионики и белых коридоров" },
    "9":  { "id": 9,  "label": "T9 — Реликвии",              "description": "Древние технологии; штучные" },
    "10": { "id": 10, "label": "T10 — Космические аномалии", "description": "Правило нарушения правил" }
  },
  "properties": {
    "strong":         { "id": "strong",         "label": "Прочный",          "description": "Прочность корпуса/брони" },
    "malleable":      { "id": "malleable",      "label": "Податливый",        "description": "Литьё/формовка; строительная основа" },
    "shield":         { "id": "shield",         "label": "Щитовой",           "description": "Годится как щит" },
    "accelerate":     { "id": "accelerate",    "label": "Ускоритель",        "description": "Двигатель/ускорение" },
    "fuel":           { "id": "fuel",           "label": "Топливо",           "description": "Топливо для движения/орудий" },
    "energy":         { "id": "energy",         "label": "Энергоресурс",      "description": "Питание реакторов" },
    "weapon_amp":     { "id": "weapon_amp",     "label": "Усилитель оружия", "description": "Усиление урона" },
    "weapon":         { "id": "weapon",         "label": "Оружие",            "description": "Сам по себе оружие" },
    "psion_store":    { "id": "psion_store",    "label": "Псион-накопитель",  "description": "Хранит псион" },
    "psion_emit":     { "id": "psion_emit",     "label": "Псион-излучатель",  "description": "Излучает псион" },
    "psion_suppress": { "id": "psion_suppress", "label": "Псион-подавитель",  "description": "Подавляет псион" },
    "info_store":     { "id": "info_store",     "label": "Хранилище данных",  "description": "Хранит информацию" },
    "corridor_open":  { "id": "corridor_open",  "label": "Открыватель коридоров", "description": "Белые коридоры/врата" },
    "matter_destroy": { "id": "matter_destroy","label": "Разрушитель материи", "description": "Микрочёрные дыры" },
    "self_spreading": { "id": "self_spreading", "label": "Самораспространение", "description": "Расползается сам" },
    "toxic":          { "id": "toxic",          "label": "Ядовитый",          "description": "Ядовит; штрафы без защиты" },
    "anomaly":        { "id": "anomaly",        "label": "Аномальный",        "description": "Аномальная физика" }
  },
  "flow_key_format": "<category>.T<tier>",
  "rps_edges": [
    { "edge": "A->B", "from": "A", "to": "B", "input1": "Extracta Tn",      "input2": "Energia Tn-1",    "output": "Materia Tn",   "description": "Руда + энергия = сплав" },
    { "edge": "B->C", "from": "B", "to": "C", "input1": "Materia Tn",       "input2": "Bios Tn-2",       "output": "Industria Tn", "description": "Сплав + рабочие = мощность" },
    { "edge": "C->D", "from": "C", "to": "D", "input1": "Industria Tn",     "input2": "Materia Tn-1",    "output": "Energia Tn",   "description": "Завод + детали = генератор/орудие" },
    { "edge": "D->E", "from": "D", "to": "E", "input1": "Energia Tn",      "input2": "Extracta Tn-2",  "output": "Bios Tn",       "description": "Энергия + вода = гидропоника/медицина" },
    { "edge": "E->F", "from": "E", "to": "F", "input1": "Bios Tn",         "input2": "Industria Tn-2", "output": "Cognitio Tn",  "description": "Население + лаб.оборудование = наука" },
    { "edge": "F->A", "from": "F", "to": "A", "input1": "Cognitio Tn",     "input2": "Energia Tn-2",  "output": "Extracta Tn+1", "description": "Технология + энергия = доступ к следующему tier добычи" }
  ],
  "bottleneck_rule": "Выход трансформации = min(входы). Tier выхода не выше минимального tier-а входов.",
  "rps_combat": {
    "slots": ["hull", "armor", "weapon", "shield", "reactor", "engine", "crew", "tactic"],
    "matchups": [
      { "attacker": "weapon", "defender": "hull",   "rule": "weapon.tier > hull.tier → пробитие" },
      { "attacker": "weapon", "defender": "shield", "rule": "weapon бьётся shield: psion_suppress пробивает shield" },
      { "attacker": "shield", "defender": "weapon", "rule": "shield поглощает weapon без psion_suppress" },
      { "attacker": "crew",   "defender": "shield", "rule": "десант/абордаж пробивает щиты (Cognitio-защита)" },
      { "attacker": "hull",   "defender": "crew",   "rule": "броня отбивает десант" }
    ]
  },
  "consumer_schema": {
    "description": "Здания/юниты/технологии описываются slots: [{role, require, count}]. Движок сам находит подходящие ресурсы из матрицы.",
    "require_format": {
      "category": "A..F (опционально)",
      "tier": ">=n (опционально; число или сравнение)",
      "properties": ["массив свойств из словаря properties"]
    },
    "effect_types": [
      "slot_require", "tier_bonus", "unlock_tech_tier", "unlock_property",
      "combat_stat_from_slot", "flow_convert", "capacity_add", "upkeep_slot"
    ]
  },
  "faction_variants": {
    "description": "Фракционные уникальности — variant от generic-шаблона. Поле base ссылается на generic id; extra_slots/extra_effects добавляют специфику.",
    "fields": ["base", "faction", "extra_slots", "extra_effects", "prerequisites"]
  },
  "legacy_bridge": {
    "description": "Авторитетны 6 category-currencies (A–F) через flowEngine. Legacy: currency.metal зеркалит net Materia; currency.supply зеркалит Bios+Energia. Траты стройки/флота пока на metal/supply.",
    "authoritative": "category stocks via flow_convert / extraction / upkeep_slots",
    "mapping": {
      "currency.metal":   "B.Materia",
      "currency.supply":  "E.Bios + D.Energia"
    }
  },
  "market": {
    "description": "NPC/межфракционный рынок — v0 stub. Курсы задаёт GM/стол; order book и SQLite отложены.",
    "status": "stub",
    "mode": "gm_table_driven",
    "placeholder_rates": [
      { "pair": "currency.metal → currency.supply", "buy": 1.0, "sell": 0.85, "note": "Legacy bridge" },
      { "pair": "currency.materia → currency.metal", "buy": 1.0, "sell": 0.95, "note": "B↔metal peg" },
      { "pair": "currency.extracta → currency.materia", "buy": 2.0, "sell": 1.6, "note": "A→B переработка" },
      { "pair": "currency.materia → currency.industria", "buy": 1.75, "sell": 1.45, "note": "B→C" },
      { "pair": "currency.industria → currency.energia", "buy": 1.55, "sell": 1.3, "note": "C→D" },
      { "pair": "currency.energia → currency.bios", "buy": 1.45, "sell": 1.2, "note": "D→E" },
      { "pair": "currency.bios → currency.cognitio", "buy": 2.0, "sell": 1.65, "note": "E→F наука" },
      { "pair": "currency.cognitio → currency.extracta", "buy": 0.55, "sell": 0.4, "note": "F→A reverse" },
      { "pair": "currency.cognitio → currency.metal", "buy": 3.5, "sell": 2.8, "note": "Научный обмен" }
    ]
  }
}
