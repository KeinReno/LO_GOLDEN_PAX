# Copy to .env on the VPS / local and change these values.
#   cp .env.example .env

# Shared secret for «Опубликовать» / master API (must match what you type in the editor).
GMAP_MASTER_TOKEN=change-me-long-random-token

# CloudPub API key (cloudpub.ru) — preferred player tunnel for RF mobile ISPs.
# Optional if you already ran `clo set token` / logged into CloudPub GUI.
# GMAP_CLOUDPUB_TOKEN=

# Optional override: cloudpub | cloudflare | ngrok | localtunnel | auto
# GMAP_SHARE_PROVIDER=cloudpub

# Public hostname (for docs / certbot). Not required by the Node app itself.
DOMAIN=map.example.com
